{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_raw.py\"",
            "timeout": 10,
            "statusMessage": "raw/ 보호 확인 중"
          }
        ]
      }
    ]
  }
}
